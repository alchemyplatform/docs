                  "pattern": "^0x([1-9a-f]+[0-9a-f]*|0)$"
                },
                "gasUsed": {
                  "title": "Gas used",
                  "type": "string",
                  "pattern": "^0x([1-9a-f]+[0-9a-f]*|0)$"
                },
                "timestamp": {
