                  "type": "string",
                  "pattern": "^0x([1-9a-f]+[0-9a-f]*|0)$"
                },
                "extraData": {
                  "title": "Extra data",
                  "type": "string",
                  "pattern": "^0x[0-9a-f]*$"
                },
                "mixHash": {
                  "title": "Mix hash",
                  "type": "string",
                  "pattern": "^0x[0-9a-f]{64}$"
                },
                "nonce": {
